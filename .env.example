# Public application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Clerk authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Neon PostgreSQL (server-only)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Optional integrations (not active until their code is implemented)
RESEND_API_KEY=re_replace_me
RESEND_FROM=SAVORUNE <updates@example.com>
TRIGGER_SECRET_KEY=tr_dev_replace_me
TRIGGER_PROJECT_REF=proj_replace_me
# Shared secret used only between Trigger.dev and the internal callback route.
CRON_SECRET=generate_a_long_random_value
# Leaflet/OpenStreetMap needs no Google API key. Configure a hosted tile
# provider here only if you choose one for production traffic.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
